# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Configuration (for production database)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Business Contact Information
NEXT_PUBLIC_WHATSAPP_NUMBER=+91XXXXXXXXXX
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/sheferoyguppy/
NEXT_PUBLIC_BUSINESS_EMAIL=contact@example.com

# Instagram Integration (Optional)
# If provided, the server automatically queries the Meta Graph API for new media with cache revalidation.
# If omitted, the site runs using the verified Sheferoy Guppy catalog and Admin Console at /admin/reels.
# Do NOT prefix with NEXT_PUBLIC_ to keep credentials secret on the server.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
